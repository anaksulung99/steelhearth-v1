NODE_ENV=production
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=3741
# Use * for desktop/Electron clients, or comma-separated origins for browser clients.
CORS_ORIGIN=*

# Use host.docker.internal if PostgreSQL is installed directly on the VPS host.
# If PostgreSQL is on another server, replace host.docker.internal with that host/IP.
DATABASE_URL=postgresql://postgres:CHANGE_ME@host.docker.internal:5432/traffic_boost

# Redis/BullMQ, installed outside Docker on the VPS host.
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ROOT_CA=
REDIS_CERT=
REDIS_KEY=
REDIS_TLS_SERVERNAME=

# Worker
API_URL=http://api:3741
API_TOKEN=
WORKER_ID=worker-vps-01
MAX_CONCURRENT=3
HEARTBEAT_INTERVAL=30000
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000

# Optional bootstrap owner user for first deploy.
SEED_USER_EMAIL=admin@example.com
SEED_USER_NAME=Admin
SEED_USER_PASSWORD=change-this-password
SEED_LICENSE_KEY=ST-PROD-CHANGE-THIS-LICENSE
