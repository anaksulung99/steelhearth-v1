{
  "name": "@tb/database",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./prisma": {
      "import": "./prisma/schema.prisma"
    }
  },
  "files": [
    "dist",
    "prisma/schema.prisma",
    "prisma/migrations",
    "prisma.config.ts",
    "src/seed.ts"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate",
    "push": "prisma db push",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "seed": "tsx src/seed.ts",
    "studio": "prisma studio",
    "validate": "prisma validate",
    "format": "prisma format"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "pg": "^8.21.0",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "rimraf": "^6.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "@prisma/client": "^7.8.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
