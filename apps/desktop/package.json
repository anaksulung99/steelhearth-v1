{
  "name": "@tb/desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "pnpm bundle:sidecars && pnpm copy:env && vue-tsc --noEmit -p tsconfig.json && vite build && electron-builder",
    "build:win": "pnpm bundle:sidecars && pnpm copy:env && vue-tsc --noEmit -p tsconfig.json && vite build && electron-builder --win",
    "build:mac": "pnpm bundle:sidecars && pnpm copy:env && vue-tsc --noEmit -p tsconfig.json && vite build && electron-builder --mac",
    "build:linux": "pnpm bundle:sidecars && pnpm copy:env && vue-tsc --noEmit -p tsconfig.json && vite build && electron-builder --linux",
    "prebundle:sidecars": "pnpm --filter @tb/contracts build && pnpm --filter @tb/database build && pnpm --filter @tb/core build",
    "bundle:sidecars": "node scripts/bundle-sidecars.mjs",
    "copy:env": "node -e \"const fs=require('fs'),path=require('path');const src=path.resolve(process.cwd(),'../..', '.env');const dst=path.resolve(process.cwd(),'resources/app.env');fs.mkdirSync(path.dirname(dst),{recursive:true});fs.copyFileSync(src,dst);console.log('Copied .env to resources/app.env')\"",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "electron:start": "electron .",
    "smoke:campaign-interrupt": "tsx scripts/campaign-interruption-smoke.ts",
    "lint": "eslint \"src/**/*.{js,ts,vue}\" \"electron/**/*.{js,ts}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts,vue}\" \"electron/**/*.{js,ts}\" --fix"
  },
  "author": {
    "name": "Steelheart",
    "email": "steelheart@steelheart.com"
  },
  "keywords": [
    "steelheart",
    "she-s-gone",
    "checker",
    "traffic exchange"
  ],
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/vue": "^1.17.0",
    "@tanstack/vue-table": "^8.21.3",
    "@tb/contracts": "workspace:*",
    "@tb/core": "workspace:*",
    "@tb/shared": "workspace:*",
    "@unovis/ts": "^1.6.5",
    "@unovis/vue": "^1.6.5",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "embla-carousel-vue": "^8.6.0",
    "happy-dom": "^20.9.0",
    "howler": "^2.2.4",
    "iconv-lite": "^0.7.2",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.35",
    "vue-input-otp": "^0.3.2",
    "vue-router": "^5.1.0",
    "vue-sonner": "^2.0.9",
    "vue3-toastify": "^0.2.9",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/radix-icons": "^1.2.6",
    "@iconify/vue": "^5.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-typescript": "^14.7.0",
    "autoprefixer": "^10.5.0",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "rollup": "^4.61.0",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.60.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.0.26"
  }
}
