{
  "name": "@tb/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "predev": "pnpm --filter @tb/contracts build && pnpm --filter @tb/database build && pnpm --filter @tb/core build",
    "dev": "tsx watch src/server.ts",
    "prebuild": "pnpm --filter @tb/contracts build && pnpm --filter @tb/database build && pnpm --filter @tb/core build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretypecheck": "pnpm --filter @tb/contracts build && pnpm --filter @tb/database build && pnpm --filter @tb/core build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/sensible": "^6.0.4",
    "@prisma/client": "^7.8.0",
    "@tb/contracts": "workspace:*",
    "@tb/core": "workspace:*",
    "@tb/database": "workspace:*",
    "@tb/shared": "workspace:*",
    "bullmq": "^5.77.7",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.11.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "prisma": "^7.8.0",
    "typescript": "^5.2.2"
  }
}
