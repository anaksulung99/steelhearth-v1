{
  "name": "@tb/worker",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "predev": "pnpm --filter @tb/contracts build && pnpm --filter @tb/database build && pnpm --filter @tb/core build",
    "dev": "tsx watch src/index.ts",
    "prebuild": "pnpm --filter @tb/contracts build && pnpm --filter @tb/database build && pnpm --filter @tb/core build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "pretypecheck": "pnpm --filter @tb/contracts build && pnpm --filter @tb/database build && pnpm --filter @tb/core build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tb/contracts": "workspace:*",
    "@tb/core": "workspace:*",
    "@tb/database": "workspace:*",
    "@crawlee/cheerio": "^3.16.0",
    "@crawlee/playwright": "^3.16.0",
    "bullmq": "^5.77.7",
    "cheerio": "^1.2.0",
    "crawlee": "^3.17.0",
    "dotenv": "^17.4.2",
    "fingerprint-generator": "^2.1.82",
    "fingerprint-injector": "^2.1.82",
    "happy-dom": "^20.9.0",
    "ioredis": "^5.11.0",
    "playwright": "^1.60.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "typescript": "^5.2.2"
  }
}
