NODE_ENV=production
LOG_LEVEL=info

# Local production API. Desktop released app should use this URL.
API_HOST=127.0.0.1
API_PORT=3741
API_URL=http://127.0.0.1:3741
CORS_ORIGIN=*
LICENSE_RESET_TOKEN=change-this-reset-token

# Point these to local PostgreSQL/Redis on your PC, or to your VPS services.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/traffic_boost

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ROOT_CA=
REDIS_CERT=
REDIS_KEY=
REDIS_TLS_SERVERNAME=

# Worker
WORKER_ID=worker-local-prod-01
MAX_CONCURRENT=3
HEARTBEAT_INTERVAL=30000
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000

# Optional owner bootstrap. Used by scripts/local-prod-build.ps1 when -Seed is passed.
SEED_USER_EMAIL=admin@example.com
SEED_USER_NAME=Admin
SEED_USER_PASSWORD=change-this-password
SEED_LICENSE_KEY=ST-LOCAL-CHANGE-THIS-LICENSE
