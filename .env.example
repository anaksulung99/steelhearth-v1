NODE_ENV=development
APP_NAME="Traffic Boost"

BASE_API_URL=http://localhost:3741/api
WS_URL=ws://localhost:3741/ws

DATABASE_URL=postgresql://postgres:password@localhost:5432/traffic_boost
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=traffic_boost
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_SSL_MODE=no-verify
DATABASE_SSL_CERT=
DATABASE_SSL_KEY=
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis BullMQ backend
# Prefer the split fields below instead of REDIS_URL when the password contains
# special characters or when TLS client certificates are required.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=forge
REDIS_PASSWORD=
REDIS_DB=0
# Optional URL form. Keep empty if you already use REDIS_HOST/PORT/USER/PASSWORD/DB.
REDIS_URL=""

# Enable TLS when using a remote Redis server with server/client certificates.
REDIS_ROOT_CA=
REDIS_CERT=
REDIS_KEY=

BULLMQ_URL=amqp://user:password@localhost:5672/

# Optional if the Redis certificate SAN/CN matches a hostname instead of the raw IP.
REDIS_TLS_SERVERNAME=""

REDIS_ENFORCE_NOEVICTION=true
REDIS_MAXMEMORY_POLICY=noeviction

WORKER_ID=worker-01
MAX_BROWSERS=5
MAX_CONCURRENT=20
WORKER_REGION=local
WORKER_REPLICAS=1
LOG_LEVEL=info
